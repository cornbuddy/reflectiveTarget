package render

import "fmt"

templ targetForm(data TargetFormData) {
	{{ new := data.ID == 0 }}
	if new {
		<h2>New target</h2>
	} else {
		<h2>{ data.Name.Value }</h2>
	}
	{{ var url, method string }}
	if new {
		{{ url, method = "/targets/new", "post" }}
	} else {
		{{ url, method = fmt.Sprintf("/targets/%d", data.ID), "put" }}
	}
	<form
		{ "hx-" + method }={ templ.URL(url) }
		hx-trigger="submit"
		hx-target={ hxTarget }
	>
		<section id="name">
			<label for="name">Target name</label>
			<input name="name" placeholder="Target name" value={ data.Name.Value }/>
			@errors(data.Name.Errors)
		</section>
		if new && len(data.Questions) == 0 {
			<section id="question_0">
				<input name="question_0_value" placeholder="Question 1"/>
			</section>
		} else {
			for i, q := range data.Questions {
				<section id={ fmt.Sprintf("question_%d", i) }>
					{{ ph := fmt.Sprintf("Question %d", i+1) }}
					<input name={ q.NameValue(i) } placeholder={ ph } value={ q.Value }/>
					<input name={ q.NameID(i) } value={ q.ID } type="hidden"/>
					@errors(q.Errors)
				</section>
			}
		}
		<canvas></canvas>
		if new {
			<button type="submit">Create</button>
		} else {
			<button type="submit">Update</button>
		}
	</form>
	if new {
		<button hx-on:click="addQuestion()">Add question</button>
	}
}
