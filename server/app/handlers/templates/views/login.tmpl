Login

<form action="/login" method="post">

    <section>
        <label for="username">Username</label>
        <input id="username"
            name="username"
            type="text"
            autocomplete="username"
            required>
    </section>

    <section>
        <label for="password">Password</label>
        <input
            id="password"
            name="password"
            type="password"
            autocomplete="password"
            required>
    </section>

    <button type="submit">Login</button>

</form>
